# Этап сборки: устанавливаем зависимости
FROM python:3.12-slim AS builder
WORKDIR /app

# Копируем только файл с зависимостями и сам файл требований, чтобы эффективно использовать кэш Docker
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Финальный этап: создаём минимальный образ
FROM python:3.12-slim
WORKDIR /app

# Копируем установленные пакеты из этапа сборки
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

# Копируем остальной код приложения
COPY . .

# Указываем порт, который будет использовать приложение
EXPOSE 5000

# Команда для запуска приложения с Uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]